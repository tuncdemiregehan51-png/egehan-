{"nbformat":4,"nbformat_minor":0,"metadata":{"colab":{"provenance":[],"authorship_tag":"ABX9TyPSZjcdTce1/Q1pPEHtzmOE"},"kernelspec":{"name":"python3","display_name":"Python 3"},"language_info":{"name":"python"}},"cells":[{"cell_type":"code","execution_count":null,"metadata":{"id":"fMtj_-NGwCSc"},"outputs":[],"source":["import ipaddress\n","\n","# Kullanıcıdan IP adresini al\n","ip_input = input(\"IP adresini gir (örnek: 192.168.1.55 veya 10.0.0.5/16): \")\n","\n","# Eğer kullanıcı maske girmediyse otomatik sınıf belirle\n","if \"/\" not in ip_input:\n","    first_octet = int(ip_input.split(\".\")[0])\n","    if 1 <= first_octet <= 126:\n","        ip_input += \"/8\"   # A sınıfı\n","    elif 128 <= first_octet <= 191:\n","        ip_input += \"/16\"  # B sınıfı\n","    elif 192 <= first_octet <= 223:\n","        ip_input += \"/24\"  # C sınıfı\n","    else:\n","        print(\"❌ Geçerli bir sınıf A, B veya C IP'si girilmedi.\")\n","        exit()\n","\n","try:\n","    ip = ipaddress.ip_interface(ip_input)\n","    net = ip.network\n","\n","    network_address = net.network_address\n","    broadcast_address = net.broadcast_address\n","    subnet_mask = net.netmask\n","    usable_hosts = net.num_addresses - 2 if net.num_addresses > 2 else 0\n","\n","    if usable_hosts > 0:\n","        first_host = list(net.hosts())[0]\n","        last_host = list(net.hosts())[-1]\n","    else:\n","        first_host = last_host = \"Yok (Bu ağda host bulunmaz)\"\n","\n","    print(\"\\n=== IP AĞ BİLGİLERİ ===\")\n","    print(f\"Girilen IP:             {ip.ip}\")\n","    print(f\"Ağ Adresi (Network):    {network_address}\")\n","    print(f\"Broadcast Adresi:       {broadcast_address}\")\n","    print(f\"Subnet Maskesi:         {subnet_mask}\")\n","    print(f\"Kullanılabilir Host Sayısı: {usable_hosts}\")\n","    print(f\"İlk Host:               {first_host}\")\n","    print(f\"Son Host:               {last_host}\")\n","\n","except ValueError:\n","    print(\"❌ Hatalı IP adresi girdin! Lütfen doğru formatta gir.\")\n","\n"]}]}